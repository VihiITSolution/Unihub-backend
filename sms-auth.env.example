SMSGO_API_KEY=
SMSGO_MASK=SMSGo
SMSGO_SANDBOX=false
SMSGO_TIMEOUT_MS=10000

RESEND_API_KEY=
EMAIL_FROM=UniHub <verify@your-verified-domain.example>
RESEND_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_PEPPER=
