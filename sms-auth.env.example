# Server-side secrets. Copy values into deployment secrets; do not commit a populated file.
SMSGO_API_BASE_URL=https://smsgo.lk
SMSGO_API_KEY=
# Required. A sender mask registered to UniHub and whitelisted by TRCSL through
# SMSGo. There is deliberately no default: sending under another party's mask is
# worse than failing, so an unset value raises a configuration error.
SMSGO_MASK=
SMSGO_SANDBOX=false
SMSGO_TIMEOUT_MS=10000

RESEND_API_KEY=
EMAIL_FROM=UniHub <verify@your-verified-domain.example>
RESEND_TIMEOUT_MS=10000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_OTP_PEPPER=
