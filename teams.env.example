# Microsoft Teams live sessions are feature-flagged and disabled by default.
TEAMS_LIVE_ENABLED=false
TEAMS_LIVE_WORKER_ENABLED=false
TEAMS_LIVE_WORKER_INTERVAL_MS=15000
TEAMS_SESSION_BUFFER_MINUTES=15

# Microsoft Entra application (client-credential flow)
#
# Required Microsoft Graph APPLICATION permissions (not delegated), each needing
# tenant-wide admin consent from a Global Administrator:
#   OnlineMeetings.ReadWrite.All      create and configure the Teams meeting
#   OnlineMeetingArtifact.Read.All    attendance reports and records
#   OnlineMeetingRecording.Read.All   meeting recordings
#   Calendars.ReadWrite               the calendar event and its invitations
#   User.Invite.All                   B2B guest invitations for tutors/students
#   User.Read.All                     resolve organizer and guest objects
#   Files.ReadWrite.All               share and delete recordings in OneDrive
#
# Scope the app to the organizer account only. Two policies are needed, and
# neither covers everything:
#   Teams    New-CsApplicationAccessPolicy / Grant-CsApplicationAccessPolicy
#            covers onlineMeetings, attendance and recordings.
#   Exchange New-ApplicationAccessPolicy against a mail-enabled security group
#            holding just the organizer; covers the calendar.
# Files.ReadWrite.All is scoped by NEITHER and stays tenant-wide, so keep the
# number of licensed mailboxes in this tenant to the minimum you actually need.
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=

# Licensed Microsoft 365 Business Basic organizer mailbox/OneDrive
TEAMS_ORGANIZER_EMAIL=
TEAMS_ORGANIZER_USER_ID=
TEAMS_INVITE_REDIRECT_URL=https://teams.microsoft.com/

# Who skips the Teams lobby. Leave unset unless you have a reason to change it.
#
# The organizer mailbox is unattended, and Teams needs someone with organizer
# rights present before it will start a meeting or admit anyone waiting. A B2B
# guest cannot be made co-organizer, so tutors cannot fill that role. Any scope
# narrower than "everyone" therefore strands the whole session in the lobby.
#
# Access is enforced by UniHub rather than by Teams: the join URL is only
# released to a student with a completed enrolment and a redeemed invitation.
#
# If the tenant ever gains a second licensed account that can act as a real
# host, "invited" becomes workable and limits entry to the meeting roster.
TEAMS_LOBBY_BYPASS_SCOPE=everyone
